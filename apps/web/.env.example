# auth-service — /api/login, /api/refresh and /api/users proxy to this
# server-side and set the session as an httpOnly cookie; the browser never
# sees the token directly.
NEXT_PUBLIC_AUTH_URL=http://localhost:8095

# Server-only — used by the /api/graphql route, never sent to the browser.
HASURA_ENDPOINT=http://localhost:8088/v1/graphql
HASURA_ADMIN_SECRET=devsecret
GENAI_SERVICE_URL=http://localhost:8093
# /api/ocr proxies document uploads (PDF / image) here. Defaults to :8096.
OCR_SERVICE_URL=http://localhost:8096
# mlModelStatus (admin settings) reads GET /models here. Defaults to :8092.
ML_SERVICE_URL=http://localhost:8092
# generateAndSendInvoice / resendInvoice / payment-received emails POST here.
# Defaults to :8094 (docker-compose's host port for notification-service).
NOTIFICATION_SERVICE_URL=http://localhost:8094
# Same value Hasura + auth-service use — the BFF verifies session JWTs against it,
# and re-mints a short-lived role-scoped token so reads run as the signed-in
# user's role (mutations stay admin, gated by the BFF).
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"dev-jwt-signing-key-change-me-32chars-min"}
# Set to 1 in a real deployment: a missing/invalid session token is then rejected
# outright. Unset/0 keeps the demo permissive (no auth service needed).
REQUIRE_AUTH=
# Must match infra/.env's INTERNAL_SERVICE_TOKEN — sent as X-Internal-Token on
# every server-to-server call to ingestion/ml/genai/notification/ocr. Those
# services reject the call without it in prod.
INTERNAL_SERVICE_TOKEN=
# server/queue.ts's outbound notification publisher. Host-mapped RabbitMQ port
# is 5673, not the default 5672 (docker-compose avoids clashing with a local
# RabbitMQ on the standard port).
RABBITMQ_URL=amqp://guest:guest@localhost:5673/

# Razorpay — "Pay via Razorpay" on an approved payable creates a Payment Link
# (amount, vendor name/email, invoice number all autofilled server-side from
# the invoice) and opens it for finance to complete. Unset -> the button shows
# "Payment gateway not configured" instead of faking a payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard webhook config (event: payment_link.paid),
# pointed at /api/payments/webhook. Verifies the callback is really Razorpay.
RAZORPAY_WEBHOOK_SECRET=
