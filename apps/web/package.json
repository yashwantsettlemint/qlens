    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@graphql-tools/schema": "^10.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "graphql": "^16.14.2",
    "next": "^14.2.35",
    "papaparse": "^5.7.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
